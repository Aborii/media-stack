# Apply the host firewall (scripts/host-firewall.sh) once docker is up.
#
# PartOf docker, so a docker restart re-runs it: docker rebuilds its own chains
# on start, and this puts DOCKER-USER back in order after it. The uplink is
# named in /etc/default/media-stack-firewall (WAN_IF=...), because at boot the
# Wi-Fi may not have a default route to guess it from yet.
#
# Install:
#   echo WAN_IF=wlp132s0f0 | sudo tee /etc/default/media-stack-firewall
#   sudo install -m 644 systemd/media-stack-firewall.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now media-stack-firewall
[Unit]
Description=Host firewall for media-stack (LAN and tailnet only)
After=docker.service tailscaled.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/media-stack-firewall
ExecStart=/home/aborii/media-stack/scripts/host-firewall.sh

[Install]
WantedBy=docker.service multi-user.target
