# Ignore container data directories
data/

# Ignore environment files with sensitive data
*.env

# Ignore log files
logs/
*.log
*.log.old

# Ignore Windows service files
windows-service/wsl-ubuntu-monitoring.exe
windows-service/wsl-ubuntu-monitoring.xml
# Container config data - API keys, databases, VPN credentials.
# NEVER commit this.
config-data/

# env backups - same secrets as the env itself
*.env.bak*
*.env.example.bak*

# Python leaves these behind whenever a script in scripts/ is run or
# syntax-checked, and they are per-interpreter-version so they churn.
__pycache__/
*.pyc

# Editing scratch left beside compose files - compose.yaml.bak2,
# .bak-preproxy, .bak-20260827-mtu and so on. Git already holds every previous
# version, so these are duplicates that clutter status until someone commits
# them by accident.
*.bak
*.bak[0-9]
*.bak-*
