	# Each pins this name as its own address (VAULTWARDEN_DOMAIN, OpenCloud's
	# OC_URL and the Euro-Office addresses), so the old ones stop signing in.
	import app vault 8222
	import app cloud 9200
	import app office 8095

	# The dashboard's buttons call these from the browser (live.js).
	import app backup 9101
	import app pcswitch 9102
	import app vpnctl 9103

	# Projects on the mini that are not part of this repo.
	#
	# Coming Manager's page, opened over https, calls its API on its own origin
	# under /_api (coming-manager-frontend docs/API-BASE-URL.md), so that path
	# goes to the API with the prefix stripped, socket.io included. One origin
	# also keeps the API's sign-in cookie on the host the page checks it on.
	# Its CORS_ORIGIN must list https://coming.<HOME_DOMAIN>.
	@coming host coming.{$HOME_DOMAIN}
	handle @coming {
		handle_path /_api/* {
			reverse_proxy 127.0.0.1:4001
		}
		handle {
			reverse_proxy 127.0.0.1:4000 {
				header_down Location "^http://(.*)$" "https://$1"
			}
		}
	}
	import app aldafter 4100
	import app aldafter-api 4101
	import app storychat 8101
	import app code 8448

	# The Claude web app's LAN door, as in ~/.config/claude-web/Caddyfile: it
	# asks for its LAN password, and the Tailscale identity headers are dropped
	# so nobody can claim to be a tailnet user through this name.
	@claude host claude.{$HOME_DOMAIN}
	handle @claude {
		reverse_proxy 127.0.0.1:8792 {
			header_up -Tailscale-User-Login
			header_up -Tailscale-User-Name
			header_up -Tailscale-User-Profile-Pic
		}
	}

	handle {
		respond "Nothing is served at this name." 404
	}
}
