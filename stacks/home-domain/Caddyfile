# Every web UI under its own name: https://jellyfin.home.almofleh.dev, with a
# real Let's Encrypt certificate that every browser and phone app trusts.
#
# One wildcard certificate covers every name, proven over DNS (see the
# Dockerfile), so adding a service is one line below and no new certificate.
# Certificates and the ACME account live in /data, which is kept on disk:
# losing it means re-issuing, and Let's Encrypt limits how often that may
# happen.
#
# Only 443. Port 80 is Glance, so there is no http-to-https redirect; .dev is
# on every browser's HTTPS-only list anyway, so typing the bare name works.
#
# 443 needs the whole host, tailnet address included: tailscale serve must not
# hold 443 (Glances moved to 8446 for this). Host networking, like tls-proxy, so
# services published on 127.0.0.1 only are reachable too.
#
# The Location rewrite and the qBittorrent Host header are the same fixes as
# in tls-proxy; its Caddyfile explains both.
{
	admin off
	auto_https disable_redirects
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

(app) {
	@{args[0]} host {args[0]}.{$HOME_DOMAIN}
	handle @{args[0]} {
		reverse_proxy 127.0.0.1:{args[1]} {
			header_down Location "^http://(.*)$" "https://$1"
		}
	}
}

(app_upstream_host) {
	@{args[0]} host {args[0]}.{$HOME_DOMAIN}
	handle @{args[0]} {
		reverse_proxy 127.0.0.1:{args[1]} {
			header_up Host {upstream_hostport}
			header_down Location "^http://(.*)$" "https://$1"
		}
	}
}

# The bare name is the dashboard.
{$HOME_DOMAIN} {
	reverse_proxy 127.0.0.1:80
}

*.{$HOME_DOMAIN} {
