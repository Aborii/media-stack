      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/srv/storage\"} / node_filesystem_size_bytes{mountpoint=\"/srv/storage\"})",
          "refId": "A",
