    {
      "type": "timeseries",
      "id": 10,
      "title": "Power draw",
      "description": "From the CPU's RAPL energy counters. \"Uncore\" is everything on the chip that is not a CPU core, which on this chip is mostly the GPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_rapl_package_joules_total[$__rate_interval])",
          "legendFormat": "CPU package (all of the chip)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_rapl_core_joules_total[$__rate_interval])",
