#################################################################################
#################################################################################
#################################################################################
##
##  Docker Compose Environment Variable file for Jellyfin / *ARR Media Stack
##
##  Update any of the environment variables below as required.
##
##  It is highly recommended Linux users set up a "docker" user, so the
##  applications can access the local filesystem with this user's access
##  privileges. Use PUID / PGID to map user access between the Docker apps
##  and local filesystem.
##
##  The MediaStack Guide is located at https://MediaStack.Guide
##
#################################################################################
#################################################################################
#################################################################################

# Name of the project in Docker
COMPOSE_PROJECT_NAME=mediastack

# This is the network subnet which will be used inside the docker "media_network", change as required.
# LOCAL_SUBNET is your home network and is needed so the VPN client allows access to your home computers.
DOCKER_SUBNET=172.28.10.0/24
DOCKER_GATEWAY=172.28.10.1
LOCAL_SUBNET=192.168.0.0/24             # This is the IP Subnet used on your home network
LOCAL_DOCKER_IP=192.168.0.159            # This is the IP Address of your Docker computer

# Each of the "*ARR" applications have been configured so the theme can be changed to your needs.
# Refer to Theme Park for more info / options: https://docs.theme-park.dev/theme-options/aquamarine/
TP_THEME=organizr

# If you intend to use Plex as your Media Server, then enter your Plex Claim
# information below, to link this Plex Media Server to your Plex account
PLEX_CLAIM=claim-your-plex-token-here

# These are the folders on your local host computer / NAS running docker, they MUST exist
# and have correct permissions for PUID and PGUI prior to running the docker compose.
#
# Use the commands in the Guide to create all the sub-folders in each of these folders.

# Host Data Folders - Will accept Linux, Windows, NAS folders.
# Make sure these folders exists before running the "docker compose" command.
FOLDER_FOR_MEDIA=/path/to/your/media       # <-- Update for your folders - Synology Example: /volume1/media
FOLDER_FOR_DATA=/path/to/your/appdata/data  # <-- Update for your folders - Synology Example: /volume1/docker/appdata/data

# File access, date and time details for the containers / applications to use.
# Run "sudo id docker" on host computer to find PUID / PGID and update these to suit.
PUID=1000
PGID=1000
UMASK=0002
TIMEZONE=Your/Timezone

# Update your own Internet VPN provide details below
# Online documentation: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_TYPE=wireguard
VPN_SERVICE_PROVIDER=your-vpn-provider
# VPN_SERVICE_PROVIDER=surfshark
VPN_USERNAME=your-vpn-username
VPN_PASSWORD=your-vpn-password

# You MUST provide at least one entry to the SERVER variables below, that supports your VPN provider's settings.
# If you want to add more than one entry per line, use comma separated values: "one,two,three" etc...
SERVER_COUNTRIES=Your Country
SERVER_REGIONS=
SERVER_CITIES=
SERVER_CATEGORIES=

# Fill in this item ONLY if you're using a custom OpenVPN configuration
# Should be inside gluetun data folder - Example: /gluetun/custom-openvpn.conf
# You can then edit it inside the FOLDER_FOR_DATA location for gluetun.
GLUETUN_CONTROL_PORT=8320

# Fill in these items ONLY if you change VPN_TYPE to "wireguard"
WIREGUARD_PRIVATE_KEY="your-wireguard-private-key"
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES="10.2.0.2/24" 





# --- gluetun's built-in proxies -----------------------------------------
# Let a device that is NOT a container send its traffic out through the same
# ProtonVPN tunnel. Shadowsocks encrypts the hop from the device to the Pi and
# needs a client app; the HTTP proxy does not encrypt it but can be typed
# straight into browser or Windows proxy settings.
SHADOWSOCKS_PORT=8388
SHADOWSOCKS_PASSWORD=a-long-random-password
HTTPPROXY_PORT=3128
HTTPPROXY_USER=your-proxy-username
HTTPPROXY_PASSWORD=another-long-random-password

# These are the default ports used to access each of the application in your web browser.
# You can safely change these if you need, but they can't conflict with other active ports.
QBIT_PORT=6881
FLARESOLVERR_PORT=8191


WEBUI_PORT_BAZARR=6767
WEBUI_PORT_HOMEPAGE=3000
WEBUI_PORT_JELLYFIN=8096
WEBUI_PORT_PROWLARR=9696
WEBUI_PORT_QBITTORRENT=8200
WEBUI_PORT_RADARR=7878
WEBUI_PORT_SEERR=5055
WEBUI_PORT_SONARR=8989


// Go to Homarr page they will generate it for you if you want
HOMARR_SECRET_ENCRYPTION_KEY=generate-a-random-32-character-hex-key-here
# SWAG is configured for Reverse Proxy. Set your Internet gateway to redirect incoming ports 80 and 443
# to the ports used below (using Docker IP Address), and they will be translated back to 80 and 443 by SWAG.
# Change these port numbers if you have conflicting services running on the Docker host computer.
# If ports 80 and 443 are already used, then adjust and redirect incoming ports to 5080 and 5443, or similar.

REVERSE_PROXY_PORT_HTTP=80
REVERSE_PROXY_PORT_HTTPS=443

# SWAG REVERSE PROXY SETTINGS:
DOMAINNAME=your-domain-name-goes-here.com      
SUBDOMAINS=wildcard
VALIDATION=dns
DNSPLUGIN=cloudflare
CERTPROVIDER=letsencrypt
PROPAGATION=
DUCKDNSTOKEN=
EMAIL=
ONLY_SUBDOMAINS=false
EXTRA_DOMAINS=
STAGING=false

# Cloudflare Tunnel for SWAG
CF_ZONE_ID=
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_TUNNEL_NAME=
CF_TUNNEL_TOKEN=

###########################################################################
##  Added for the Pi migration
###########################################################################

# Single Compose project so one 'docker compose up -d' manages everything.
COMPOSE_PROJECT_NAME=mediastack

# --- new services ---
WEBUI_PORT_KAVITA=5000

# --- immich ---
# Pinned on purpose: Immich's database migrations are one-way, so an
# accidental major upgrade cannot be rolled back without a dump restore.
IMMICH_VERSION=v3.1.0
IMMICH_PORT=2283
IMMICH_DB_USERNAME=immich
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_PASSWORD=PASTE_A_LONG_RANDOM_PASSWORD_HERE

# --- homepage ---
# Required since v0.9. Without it Homepage rejects requests whose Host
# header it does not recognise and you get a blank page. Narrow this to
# your Pi's address/hostname once settled.
HOMEPAGE_ALLOWED_HOSTS=*

# --- tdarr (server on the Pi, node on the desktop) ---
WEBUI_PORT_TDARR=8265
TDARR_SERVER_PORT=8266

# --- monitoring ---
WEBUI_PORT_UPTIMEKUMA=3001
WEBUI_PORT_SCRUTINY=8081
WEBUI_PORT_DOZZLE=8888

# --- dockge ---
WEBUI_PORT_PORTAINER=9000

# ─── Shared PostgreSQL 17 (stacks/postgres) ─────────────────────────────────
# One cluster for every app that needs Postgres, one database + one role each.
# Immich is NOT here: it is pinned to PG14 with its own vector extensions.
SHARED_POSTGRES_USER=postgres
SHARED_POSTGRES_PASSWORD=changeme-use-a-long-random-string
SHARED_POSTGRES_PORT=5432

# ─── prayer (stacks/prayer) ─────────────────────────────────────────────────
# Dubai prayer times from IACAD, cached a year ahead, for the Homepage tile.
WEBUI_PORT_PRAYER=3003
# IACAD city: 1 Dubai City, 2 Rural areas of Dubai, 3 Hatta, 4 Sharjah City.
# Those four are all it publishes.
PRAYER_CITY=1
# Hours east of UTC. The UAE is +4 all year, no daylight saving.
PRAYER_UTC_OFFSET=4

# ─── glance (stacks/glance) ─────────────────────────────────────────────────
# A second dashboard, on trial beside Homepage. Its config is one file at
# ${FOLDER_FOR_DATA}/glance/glance.yml; the reference copy is examples/glance/.
WEBUI_PORT_GLANCE=3004

# ─── coming-manager (database on the shared postgres17 cluster) ─────────────
COMING_MANAGER_DB_NAME=coming_manager_db
COMING_MANAGER_DB_USER=coming_manager
COMING_MANAGER_DB_PASSWORD=changeme-use-a-long-random-string

# ─── Private image registry (stacks/registry) ───────────────────────────────
# Bound to 127.0.0.1 only. Docker trusts localhost registries with no daemon
# configuration, so there is nothing to add to daemon.json on either machine.
REGISTRY_PORT=5001

# ─── coming-manager (stacks/coming-manager) ─────────────────────────────────
# Image references. `pnpm docker:build --registry=localhost:5000 --push` on the
# dev PC prints the exact tag it published; pinning that version tag instead of
# `latest` is what gives you a rollback target.
COMING_MANAGER_API_IMAGE=localhost:5001/coming-manager-api-server:latest
COMING_MANAGER_WEB_IMAGE=localhost:5001/coming-manager-web-client:latest
COMING_MANAGER_API_PORT=4001
COMING_MANAGER_WEB_PORT=4000

# Copy these four VERBATIM from coming-manager-server/.env on the dev machine.
# The restored database already contains the seeded admin row, so a fresh JWT
# secret logs every existing session out, and a different admin password stops
# matching the stored hash.
COMING_MANAGER_JWT_SECRET=copy-from-dev-env
COMING_MANAGER_JWT_REFRESH_SECRET=copy-from-dev-env
COMING_MANAGER_ADMIN_USERNAME=copy-from-dev-env
COMING_MANAGER_ADMIN_PASSWORD=copy-from-dev-env

# Optional. Required together for personal-account login on /telegram; leave
# all three blank and that page reports account login unavailable.
COMING_MANAGER_TELEGRAM_API_ID=
COMING_MANAGER_TELEGRAM_API_HASH=
COMING_MANAGER_TELEGRAM_ENCRYPTION_KEY=

# Max time (ms) FlareSolverr may spend on one request.
COMING_MANAGER_FLARESOLVERR_TIMEOUT_MS=60000

# ─── Registry UI (stacks/registry) ──────────────────────────────────────────
# Browsable web UI for the private registry, at http://aboriis-pi:5002.
# Published on the LAN unlike the registry itself, which stays loopback-only.
REGISTRY_UI_PORT=5002
REGISTRY_UI_TITLE=aboriis-pi registry
# Leave false unless pruning: the UI has no auth, so true means an
# unauthenticated delete button for anyone who can reach port 5002.
REGISTRY_UI_DELETE=false

# ─── coming-manager host paths ──────────────────────────────────────────────
# Library and its derivatives: under /srv/storage/media, which is NOT inside
# the [storage] Samba share (/srv/storage/data), so it never shows up when
# browsing the NAS over the network.
COMING_MANAGER_DOWNLOADS=/srv/storage/media/coming-manager/downloads
COMING_MANAGER_ALBUMS_BACKUP=/srv/storage/media/coming-manager/albums-manual-backup
COMING_MANAGER_MODELS=/srv/storage/media/coming-manager/models
# Operational data: kept beside the rest of coming-manager rather than under
# appdata, so every path this stack writes to lives in one place. Deliberately
# NOT backed up - these are development dumps, and the live database is already
# captured by the nightly pg_dump in scripts/backup.sh.
COMING_MANAGER_LOGS=/srv/storage/media/coming-manager/logs
COMING_MANAGER_DB_BACKUPS=/srv/storage/media/coming-manager/db-backups

# ─── Ollama (stacks/ollama) ─────────────────────────────────────────────────
# Embedding model server for the "Similar meaning (AI)" tag matching.
OLLAMA_PORT=11434
# Unload the model when idle this long. Embedding runs in bursts, not
# continuously, so keeping it resident just holds memory this box lacks.
OLLAMA_KEEP_ALIVE=30s
# Hard ceiling. Swap here is fully consumed, so this makes ollama the process
# that dies under pressure rather than immich or jellyfin.
OLLAMA_MEM_LIMIT=1500m

# Embedding subsystem for coming-manager. Set the driver to openai-compat to
# turn it on; leave it noop and tag matching stays lexical-only.
COMING_MANAGER_EMBEDDING_DRIVER=openai-compat
COMING_MANAGER_EMBEDDING_MODEL=nomic-embed-text
COMING_MANAGER_EMBEDDING_BATCH_SIZE=64
COMING_MANAGER_EMBEDDING_TIMEOUT_MS=120000

# Origins allowed to call the API from a browser. The built-in allowlist is
# localhost-only, so the deployed UI origin must be named here or every
# request is blocked by the browser.
COMING_MANAGER_CORS_ORIGIN=http://aboriis-pi:4000,http://aboriis-pi.tail54d520.ts.net:4000,http://192.168.0.143:4000
